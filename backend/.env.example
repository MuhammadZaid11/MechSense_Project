# Copy this file to backend/.env for local development.
# Never commit backend/.env.

PORT=3001
NODE_ENV=development

# PostgreSQL connection used by the API, migrations, and seed scripts.
DATABASE_URL=postgresql://mechsense:changeme@127.0.0.1:5432/mechsense

# Optional overrides for docker-compose.postgres.yml
POSTGRES_USER=mechsense
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mechsense

# Simulator and demo freshness window. Teaching values only.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
STALE_AFTER_SECONDS=30
