# MechSense root environment placeholders.
# Copy values into backend/.env and frontend/.env as needed.
# Never commit real secrets.

# Backend
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://mechsense:changeme@127.0.0.1:5432/mechsense

# Optional overrides for docker-compose.postgres.yml
POSTGRES_USER=mechsense
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mechsense
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
STALE_AFTER_SECONDS=30

# Frontend
VITE_API_BASE_URL=http://localhost:3001
